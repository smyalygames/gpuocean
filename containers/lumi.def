BootStrap: docker
From: rocm/dev-ubuntu-24.04:6.4.3-complete

%environment
    export PATH=/opt/.venv/bin:/root/.local/bin:$PATH
    export VIRTUAL_ENV=/opt/.venv
    export ROCM_HOME=/opt/rocm

%files
   .python-version /opt
   pyproject.toml /opt
   uv.lock /opt

%post
    # Version values
    # MPI on LUMI is 3.4a2
    export MPICH_VERSION=3.4.3
    export MPICH_URL="http://www.mpich.org/static/downloads/$MPICH_VERSION/mpich-$MPICH_VERSION.tar.gz"
    # Python virtual environment directory
    export VIRTUAL_ENV=/opt/.venv

    # Base OS
    echo -e "\e[32m + \e[39mInstalling \e[1mrequired packages\e[0m..."
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y file g++ gcc gfortran make gdb strace wget curl ca-certificates build-essential


    # Install MPICH
    wget -q $MPICH_URL
    tar xf mpich-$MPICH_VERSION.tar.gz
    cd mpich-$MPICH_VERSION

    ./configure --disable-fortran --enable-fast=all,O3 --prefix=/usr --with-device=ch3 --with-hip=/opt/rocm
    make -j$(nproc)
    make install
    ldconfig

    # Install netcdf
    apt-get install hdf5-tools libhdf5-mpich-310 netcdf-parallel

    # Install uv
    echo -e "\e[32m + \e[39mInstalling \e[uv\e[0m..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
    . $HOME/.local/bin/env

    # Create uv virtual environment
    echo -e "\e[32m + \e[39mCreating \e[uv environment\e[0m..."
    cd /opt
    uv sync

    # Hacky method of installing cupy through uv
    uv pip uninstall amd-cupy
    uv pip install amd-cupy --extra-index-url https://pypi.amd.com/rocm-7.0.2/simple

    # Cleanup
    apt-get clean
    rm -rf /var/lib/apt /var/lib/dpkg /var/lib/cache /var/lib/log

#%startscript
#    . $HOME/.local/bin/env

%help
    This is a container built for running GPU Ocean on LUMI-G.
    It includes MPICH and the required uv packages.
